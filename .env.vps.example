# Environnement du VPS — à copier en `.env.vps` SUR LE SERVEUR et à remplir.
#
# Ce fichier-ci est un MODÈLE et il est versionné ; `.env.vps`, lui, contient
# des secrets et ne doit jamais l'être (il est dans .gitignore).

# --- Application ---------------------------------------------------------
APP_NAME="Dolibarr Maroc"
APP_ENV=production
APP_DEBUG=false

# OBLIGATOIRE, et posée une seule fois : la changer, ou la perdre, rend
# illisible tout ce qui est chiffré en base. Laissez-la VIDE :
# scripts/deploy-vps.sh l'engendre sur le serveur sans l'afficher, et ne
# touche jamais à une valeur déjà présente. À la main :
#   echo "base64:$(openssl rand -base64 32)"
# (`docker run … key:generate --show` ne marche pas : l'entrypoint de l'image
# ignore ses arguments et lance le serveur.)
APP_KEY=

# L'URL PUBLIQUE, en https. Elle sert aux liens des courriels de
# réinitialisation : en http, le lien enverrait le mot de passe sur un canal
# clair, et derrière un proxy Laravel ne peut pas la deviner seul.
APP_URL=https://crm.mediadesk.ma

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

# --- Base de données -----------------------------------------------------
# `db` est le nom du service Compose : c'est le réseau interne qui résout,
# aucun port n'est exposé au dehors.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=dolibarr
DB_USERNAME=dolibarr
# Laissez VIDE : scripts/deploy-vps.sh l'engendre. À la main, en hexadécimal
# (aucun caractère que Compose ou un shell pourrait interpréter) :
#   openssl rand -hex 24
DB_PASSWORD=

# --- Sessions, cache, file d'attente -------------------------------------
# En base : le conteneur est jetable, un cache sur disque disparaîtrait à
# chaque redéploiement. C'est aussi ce dont dépendent les compteurs de la
# limitation de débit.
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_LIFETIME=120

# --- Courriel ------------------------------------------------------------
# ⚠️ `log` veut dire QUE RIEN NE PART. La récupération de mot de passe et les
# invitations d'équipe échouent alors EN SILENCE : l'utilisateur voit
# « e-mail envoyé » et n'attendra jamais rien. Renseignez un vrai SMTP
# (Brevo, SendGrid, ou celui de Hostinger) avant d'ouvrir le service à
# quelqu'un d'autre que vous.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=contact@mediadesk.ma
MAIL_FROM_NAME="${APP_NAME}"

# --- Reprise Zoho Books --------------------------------------------------
# Centre de données EUROPÉEN : le `.com` répond « invalid_client » et laisse
# croire que les identifiants sont faux.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.eu
ZOHO_BOOKS_API_URL=https://www.zohoapis.eu/books/v3
ZOHO_BOOKS_ORGANIZATION_ID=20080363566
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

LOG_CHANNEL=stack
LOG_LEVEL=warning
